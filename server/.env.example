# copie este arquivo para server/.env e ajuste os valores.

NODE_ENV=development
PORT=3333

# banco local (replica set rs0)
MONGO_URI=mongodb://127.0.0.1:27017/jersey?replicaSet=rs0&directConnection=true

# secret que assina os tokens de login, de pelo menos 32 caracteres.
# gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# endereço do front para o CORS
CLIENT_ORIGIN=http://localhost:5173
