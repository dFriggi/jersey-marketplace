{
  "name": "jersey-marketplace",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "jersey-marketplace",
      "version": "1.0.0",
      "workspaces": [
        "shared",
        "server"
      ]
    },
    "node_modules/@jersey/server": {
